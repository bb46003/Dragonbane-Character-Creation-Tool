<section class="character-creation-button">
<div class="flexrow">    
<button data-action="changeTab" data-type="-1" {{#if (eq _state.activeTab "kin")}}disabled{{/if}}>{{localize "DCCT.characterCreation.previous"}}</button>
{{#if (ne _state.activeTab "summary")}}
<button data-action="changeTab" data-type="1"{{#if (and (eq _state.name "") (eq _state.activeTab "age"))}}disabled{{/if}}>{{localize "DCCT.characterCreation.next"}}</button>
{{else}}
<button data-action="createActor">{{localize "DCCT.characterCreation.create"}}</button>
{{/if}}
</div> 
</section>