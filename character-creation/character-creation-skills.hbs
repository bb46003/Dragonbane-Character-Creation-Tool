<section
  class="tab skills {{tabs.skills.cssClass}}"
  action-data="tab"
  data-tab="skills"
>
  <div class="block">
    <label>{{localize "DCCT.characterCreation.skillsProfession"}}</label>
    <div class="form-group profession-skills" data-type="profession">

      <label class="main-label">{{localize
          "DCCT.characterCreation.skillsProfessionAll"
        }}</label>
      <div class="skill-count">
        <p>{{localize "DCCT.characterCreation.selectedSkill"}}</p>
        <p class="selected-skill-proffesion">0</p>
        <p>/</p>
        <p>{{localize "DCCT.characterCreation.avaliabeSkill"}} 6</p>
      </div>
      <div class="flexcol skill-list">

        {{#each skills.professionSkills as |skill|}}
          <div class="flexrow" data-name="{{skill}}">
            <label>
              {{localize skill}}
            </label>
            <input type="checkbox" />
          </div>
        {{/each}}
      </div>
    </div>
    <div class="form-group other-skills" data-type="other">
      <label class="main-label">{{localize
          "DCCT.characterCreation.skillsOther"
        }}</label>
      <div class="skill-count">
        <p>{{localize "DCCT.characterCreation.selectedSkill"}}</p>
        <p class="selected-skill-other">0</p>
        <p>/</p>
        <p>{{localize "DCCT.characterCreation.avaliabeSkill"}}
          {{_state.numberOfSelectedSkills}}</p>
      </div>
      <div class="flexcol skill-list">
        {{#each skills.availableSkills as |skill|}}
          <div class="flexrow" data-name="{{skill}}">
            <label>
              {{localize skill}}
            </label>
            <input type="checkbox" />
          </div>
        {{/each}}
      </div>
    </div>
  </div>
</section>