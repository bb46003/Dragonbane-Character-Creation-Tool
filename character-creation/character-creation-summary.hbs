<section   class="tab summary {{tabs.summary.cssClass}}"  action-data="tab"  data-tab="summary">    
    <div class="block">
        <label>{{localize "DCCT.characterCreation.summary"}}</label>
    </div>
    <div>
        <div class="flexcol">
            <div class="flexrow"> 
                <label>{{localize "DCCT.characterCreation.choiceKin"}}</label>
                <Label class="bold">{{selectedKin.name}}</Label>
            </div>
            <label>{{localize "DoD.ui.character-sheet.abilities"}}</label>
            <ul>
                {{#each selectedKin.abilities}}
                    <li>
                        <label class="bold">{{this.name}}</label>
                    </li>
                {{/each}}
            </ul>
        </div>
        <div class="flexcol">
            <div class="flexrow"> 
                <label>{{localize "DCCT.characterCreation.choiceProfession"}}</label>
                <label class="bold">{{lookup (lookup profession _state.selectedProfessionIndex) "name"}}</label>
            </div>        
            <ul>
                {{#each (lookup (lookup profession _state.selectedProfessionIndex) "abilities") as |abilitie|}}
                    <li>
                        <label class="bold">{{abilitie.name}}</label>
                    </li>
                {{/each}}
            </ul>
        </div>
        <div class="flexrow">
            <label> {{localize "DCCT.characterCreation.name"}}</label>
            <label class="bold">{{_state.name}}</label>
        </div>
        <div class="flexrow">
            <label>{{localize "DCCT.characterCreation.age"}}</label>
            <label class="bold">{{localize (concat "DoD.ageTypes." _state.age)}}</label>
        </div>
        <div>
            <label>{{localize "DCCT.characterCreation.attributes"}}</label>
            {{#each config.attributes as |attribute|}}
                <div class="flexrow">
                    <label>
                        {{localize attribute}}
                    </label>
                    <input type="number" value="{{lookup ../_state.attributes @key}}" min="1" max="18" disabled/>
                </div>
            {{/each}}
        </div>
        <div class="flexrow">
            <label>{{localize "DCCT.characterCreation.skillsProfession"}}</label>
            <div class="skill-list">
                <ul> 
                    {{#each _state.selectedSkills as |skill|}}
                    <li>
                        <label>{{skill}}</label>
                    </li>
                    {{/each}}
                </ul>
            </div>
        </div>
        <div class="flexrow">
        {{#if (ne _state.gear "")}}
            <label>{{localize "DCCT.characterCreation.gear"}}</label>
         <ul>  
            {{#each gearName as |gear|}}
            <li>            
                <label>{{gear}}</label>
            </li>
            {{/each}}
         </ul>
        {{/if}}
        </div>
        <div class="flexrow">
        {{#if (ne _state.weakness "")}}
            <label>{{localize "DCCT.characterCreation.weakness"}}</label>
            <label>{{{weaknessHTML}}}</label>
        {{/if}}
        </div>
         <div class="flexrow">
        {{#if (ne _state.memento "")}}
            <label>{{localize "DCCT.characterCreation.memento"}}</label>
            <label>{{mementoName}}</label>
        {{/if}}
        </div>
    </div>
</section>