<div class="form-group skip-folder">
    <div class="settings-folder-list">
        {{#each uniqueFolders}}
            <div class="flexrow">
                <label>{{this.name}}</label>
                <input
                    type="checkbox"
                    data-folder="{{this.folderId}}"
                    {{#if (isInArray this.folderId ../selectedFolders)}}checked{{/if}}
                >
            </div>
        {{/each}}
    </div>
</div>